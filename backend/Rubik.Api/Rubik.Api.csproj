<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>Rubik.Api</RootNamespace>
    <!-- XML doc comments feed the Swagger descriptions. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- Running the "http" launch profile also starts the Vite dev server (or reuses one already on 5173). -->
    <SpaRoot>..\..\frontend\</SpaRoot>
    <SpaProxyServerUrl>http://localhost:5173</SpaProxyServerUrl>
    <SpaProxyLaunchCommand>npm run dev</SpaProxyLaunchCommand>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SpaProxy" Version="10.0.13" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Rubik.Core\Rubik.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Rubik.Test" />
    <InternalsVisibleTo Include="Rubik.Integration.Test" />
  </ItemGroup>

  <!-- On a fresh clone, install the frontend packages so the SPA proxy can run 'npm run dev'.
       Skipped in CI, where the frontend job installs them itself. -->
  <Target Name="EnsureFrontendPackages" BeforeTargets="Build"
          Condition="'$(Configuration)' == 'Debug' And '$(CI)' != 'true' And !Exists('$(SpaRoot)node_modules')">
    <Exec Command="node --version" ContinueOnError="true" StandardOutputImportance="low">
      <Output TaskParameter="ExitCode" PropertyName="NodeExitCode" />
    </Exec>
    <Error Condition="'$(NodeExitCode)' != '0'" Text="Node.js is required to run the frontend. Install it from https://nodejs.org/ and restart Visual Studio." />
    <Message Importance="high" Text="Installing frontend packages with 'npm ci'. This takes a minute the first time..." />
    <Exec WorkingDirectory="$(SpaRoot)" Command="npm ci" />
  </Target>

</Project>
