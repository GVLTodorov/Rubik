root = true

[*]
charset = utf-8
insert_final_newline = true
indent_style = space

[*.{cs,csx}]
indent_size = 4

[*.{csproj,props,targets,json,xml}]
indent_size = 2

# Test names use Method_Scenario_Expectation underscores.
[*.Test/**.cs]
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1861.severity = none
