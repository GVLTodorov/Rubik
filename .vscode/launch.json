{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend (Rubik.Api)",
      "presentation": { "hidden": true },
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "backend: build",
      "program": "${workspaceFolder}/backend/Rubik.Api/bin/Debug/net10.0/Rubik.Api.dll",
      "args": [],
      "cwd": "${workspaceFolder}/backend/Rubik.Api",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5080"
      },
      "console": "internalConsole",
      // Opens Swagger as a tab in your already-running default browser instead of a
      // separate debug Chrome. Swagger's top bar has a "UI" button that opens the React app.
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "Now listening on: (https?://\\S+)",
        "uriFormat": "%s/swagger"
      }
    },
    {
      // Runs Vite as a debuggee (not a background task) so stopping the session kills
      // the whole process tree. No browser is opened for it; use Swagger's "UI" button.
      "name": "UI (vite)",
      "presentation": { "hidden": true },
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/frontend",
      "program": "${workspaceFolder}/frontend/node_modules/vite/bin/vite.js",
      "args": [],
      "console": "internalConsole",
      "outputCapture": "std",
      "autoAttachChildProcesses": false,
      "killBehavior": "forceful"
    }
  ],
  // Only the compound shows in the Run and Debug dropdown; the single configs are
  // hidden and exist to be composed here.
  "compounds": [
    {
      "name": "Backend + UI",
      "configurations": ["Backend (Rubik.Api)", "UI (vite)"],
      "stopAll": true
    }
  ]
}
